# ============================================================
# 星职统一后端环境配置模板 —— 复制为 .env 后填写真实值
# cp .env.example .env
# ============================================================

# ── 服务 ──
SERVER_PORT=8080

# ── MySQL（youthpath 库，含全部 31 张表）──
DB_URL=jdbc:mysql://localhost:3306/youthpath?allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowMultiQueries=true
# ⚠️ allowMultiQueries=true 必须保留：画像能力 Mapper 使用多语句 SQL（insert;select）
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ── 邮件（QQ 邮箱 SMTP）──
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_account@qq.com
MAIL_PASSWORD=your_smtp_authorization_code

# ── RSA 公私钥（登录传输加密）──
RSA_PRIVATE_KEY=your_rsa_private_key
RSA_PUBLIC_KEY=your_rsa_public_key

# ── AES 存储密钥（16 字符）──
AES_KEY=your_16_char_key
AES_IV=your_16_char_iv

# ── 蚂蚁百宝箱应用（A02 对话/多智能体能力）──
# 基址来自平台注入的环境变量 APP_API_URL（预览态域名会变，勿硬编码）
# 连通自检：GET {TBOX_API_URL}/api/health → {"status":"ok"}
TBOX_API_URL=https://<appid>.tboxpro.cn
# 报名所得密钥，格式 inc-akxxxx（请勿提交真实值）
TBOX_API_KEY=inc-ak-your-tbox-token
# 报告类接口专用令牌（平台配置 REPORT_API_TOKEN 后必填；未配置留空）
TBOX_REPORT_TOKEN=
# 应用 ID（/api/tbox/session 返回的 appId）
TBOX_AGENT_ID=202609APxxxxxxxxx
# 单次对话超时（秒）
TBOX_TIMEOUT_SECONDS=30
# 对话通道：http = 平台专用 SSE /api/chat/stream（默认）；ws = 旧 WebSocket /ws（兜底）
TBOX_CHAT_CHANNEL=http
# 对话（HTTP SSE）超时（秒，含 RAG 检索空窗）
TBOX_CHAT_TIMEOUT_SECONDS=180
# 职业报告（6 智能体串行）超时（秒，实测 160~185s）
TBOX_REPORT_TIMEOUT_SECONDS=360
# 职业报告异步任务轮询间隔（秒）
TBOX_REPORT_POLL_SECONDS=4
# HELLO 与 SEND_MESSAGE 发送间隔（毫秒）
TBOX_HELLO_DELAY_MS=500
