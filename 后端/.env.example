# ============================================================
# 星职统一后端环境配置模板 —— 复制为 .env 后填写真实值
# cp .env.example .env
# ============================================================

# ── 服务 ──
SERVER_PORT=8080

# ── MySQL（youthpath 库，含全部 31 张表）──
DB_URL=jdbc:mysql://localhost:3306/youthpath?allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ── 邮件（QQ 邮箱 SMTP）──
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_account@qq.com
MAIL_PASSWORD=your_smtp_authorization_code

# ── RSA 公私钥（登录传输加密）──
RSA_PRIVATE_KEY=your_rsa_private_key
RSA_PUBLIC_KEY=your_rsa_public_key

# ── AES 存储密钥（16 字符）──
AES_KEY=your_16_char_key
AES_IV=your_16_char_iv

# ── 蚂蚁百宝箱开放 API（A02 改造后对话/多智能体能力，报名后填写）──
TBOX_API_URL=
TBOX_API_KEY=
TBOX_AGENT_ID=
