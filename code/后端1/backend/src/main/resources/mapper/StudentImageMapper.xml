<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.web.mapper.StudentImageMapper">
    <!-- 全字段结果映射 -->
    <resultMap id="StudentImageMap" type="org.example.web.entity.StudentImage">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="image_type" property="imageType"/>
        <result column="create_time" property="createTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 公共表名片段 -->
    <sql id="baseTable">student_image</sql>

    <!-- 新增图片记录 -->
    <insert id="insert">
        insert into <include refid="baseTable" />
        (id, user_id, file_name, file_path, image_type, create_time, is_deleted)
        values
        (#{id}, #{userId}, #{fileName}, #{filePath}, #{imageType}, #{createTime}, #{isDeleted})
    </insert>

    <!-- 根据ID删除（逻辑删除） -->
    <update id="deleteById">
        update <include refid="baseTable" /> 
        set is_deleted = 1 
        where id = #{id} and is_deleted = 0
    </update>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="StudentImageMap">
        select * from <include refid="baseTable" /> 
        where id = #{id} and is_deleted = 0
    </select>

    <!-- 根据用户ID查询图片列表 -->
    <select id="selectByUserId" resultMap="StudentImageMap">
        select * from <include refid="baseTable" /> 
        where user_id = #{userId} and is_deleted = 0
        order by create_time desc
    </select>

    <!-- 根据用户ID和图片类型查询 -->
    <select id="selectByUserIdAndType" resultMap="StudentImageMap">
        select * from <include refid="baseTable" /> 
        where user_id = #{userId} and image_type = #{imageType} and is_deleted = 0
        order by create_time desc
    </select>
</mapper>